{
    "name": "broken-ranks-frontend",
    "private": true,
    "version": "0.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "check:bundle-size": "node scripts/check-bundle-size.mjs",
        "assets:optimize": "node scripts/optimize-assets.mjs",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "lint": "eslint .",
        "test": "vitest run",
        "test:coverage": "vitest run --coverage && node scripts/check-coverage-floor.mjs",
        "test:e2e": "playwright test",
        "test:integration": "playwright test --config playwright.integration.config.js",
        "preview": "vite preview",
        "docs": "node scripts/generate-docs.mjs"
    },
    "dependencies": {
        "axios": "^1.13.6",
        "react": "^19.3.0",
        "react-dom": "^19.3.0"
    },
    "devDependencies": {
        "@axe-core/playwright": "^4.13.0",
        "@eslint/js": "^9.39.1",
        "@playwright/test": "^1.63.0",
        "@tailwindcss/postcss": "^4.3.3",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.7",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^5.1.1",
        "@vitest/coverage-v8": "^4.1.11",
        "eslint": "^9.39.1",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.1.1",
        "eslint-plugin-react-refresh": "^0.5.7",
        "globals": "^16.5.0",
        "jsdoc": "^4.0.3",
        "jsdom": "^29.1.1",
        "msw": "^2.15.0",
        "postcss": "^8.5.29",
        "prettier": "^3.9.9",
        "sharp": "^0.35.5",
        "tailwindcss": "^4.3.3",
        "vite": "^7.3.1",
        "vitest": "^4.1.11",
        "yaml": "^2.9.1"
    }
}
